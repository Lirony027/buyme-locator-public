{
  "name": "buyme-locator",
  "version": "1.0.0",
  "private": true,
  "description": "Map of where BuyMe, תו הזהב and Swish gift cards can be used, for BuyMe sales staff.",
  "scripts": {
    "test": "node --test \"poc/lib/*.test.mjs\"",
    "build": "node --env-file=.env.local scripts/build-google-page.mjs",
