# Raw upstream payloads cached so re-runs cost no network requests.
# Regenerated by scripts/resolve-buyme-*.mjs; never meant to be committed.
.cache/

# Vercel's link between this directory and the deployment project. Written by
# the CLI, specific to whoever deployed, and not part of the source.
.vercel

# Google-derived coordinates, which Places forbids retaining beyond 30 days.
# Committing them would be that violation in durable form — the same reason
# buyme-chains-google.json is ignored.
tav-locations-google.json
